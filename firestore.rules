rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'e8pMV4UWA6dJrYMfYYUIc3scTZJ2';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Solo nickname/avatar modificabili dal client; XP/carte/level solo admin
    function utenteUpdateSoloCosmetico() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['nickname'])
        || changed.hasOnly(['avatar'])
        || changed.hasOnly(['nickname', 'avatar']);
    }

    function lobbyGiocatoriValidi() {
      return request.resource.data.players is list
        && request.resource.data.players.size() <= request.resource.data.maxPlayers;
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /bans/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update, delete: if isAdmin();
    }

    match /security_events/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'type', 'createdAt']);
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /security_flags/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin();
    }

    match /utenti/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && utenteUpdateSoloCosmetico());
      allow delete: if isAdmin();
    }

    match /lobbies/{lobbyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && lobbyGiocatoriValidi();
      allow update: if isSignedIn() && lobbyGiocatoriValidi();
      allow delete: if isAdmin();

      match /presence/{playerId} {
        allow read: if isSignedIn();
        allow write: if isOwner(playerId);
        allow delete: if isOwner(playerId) || isAdmin();
      }
    }

    match /carte/{cartaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /games/{gameId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();

      match /hands/{handId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isAdmin();
      }
    }
  }
}
