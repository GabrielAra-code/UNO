rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'e8pMV4UWA6dJrYMfYYUIc3scTZJ2';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Solo nickname/avatar modificabili dal client; XP/carte/level solo admin
    function utenteUpdateSoloCosmetico() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['nickname'])
        || changed.hasOnly(['avatar'])
        || changed.hasOnly(['nickname', 'avatar']);
    }

    function livelloDaXp(xp) {
      let xpVal = xp is int ? xp : 0;
      if (xpVal < 0) {
        xpVal = 0;
      }
      return min(500, max(1, xpVal / 100 + 1));
    }

    // Ricompense partita: XP e livello coerenti, statistiche solo in aumento
    function utenteUpdateProgressoPartita() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let prevXp = resource.data.get('xp', 0);
      let prevPartite = resource.data.get('partiteGiocate', 0);
      let prevVittorie = resource.data.get('vittorie', 0);
      let nextXp = request.resource.data.get('xp', 0);
      return changed.hasOnly(['xp', 'livello', 'partiteGiocate', 'vittorie'])
        && nextXp >= prevXp
        && request.resource.data.partiteGiocate >= prevPartite
        && request.resource.data.vittorie >= prevVittorie
        && request.resource.data.livello == livelloDaXp(nextXp);
    }

    function lobbyGiocatoriValidi() {
      return request.resource.data.players is list
        && request.resource.data.players.size() <= request.resource.data.maxPlayers;
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /bans/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update, delete: if isAdmin();
    }

    match /security_events/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'type', 'createdAt']);
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /security_flags/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin();
    }

    match /utenti/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isAdmin()
        || (isOwner(userId) && utenteUpdateSoloCosmetico())
        || (isOwner(userId) && utenteUpdateProgressoPartita());
      allow delete: if isAdmin();
    }

    match /lobbies/{lobbyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && lobbyGiocatoriValidi();
      allow update: if isSignedIn() && lobbyGiocatoriValidi();
      allow delete: if isAdmin();

      match /presence/{playerId} {
        allow read: if isSignedIn();
        allow write: if isOwner(playerId);
        allow delete: if isOwner(playerId) || isAdmin();
      }
    }

    match /carte/{cartaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /annunci/{annuncioId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /games/{gameId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();

      match /hands/{handId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isAdmin();
      }
    }
  }
}
